#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -z "${JAVA_HOME:-}" ]; then
  if [ -x /usr/libexec/java_home ]; then
    _JH="$(/usr/libexec/java_home 2>/dev/null || true)"
    [ -n "$_JH" ] && export JAVA_HOME="$_JH"
  fi
  if [ -z "${JAVA_HOME:-}" ]; then
    for candidate in /Library/Java/JavaVirtualMachines/*/Contents/Home /usr/lib/jvm/java-17* /usr/lib/jvm/default-java; do
      if [ -d "$candidate" ]; then
        export JAVA_HOME="$candidate"
        break
      fi
    done
  fi
fi

if [ -n "${JAVA_HOME:-}" ]; then
  export PATH="$JAVA_HOME/bin:$PATH"
fi

exec scala-cli run "$DIR/project.scala" "$DIR/src" --main-class sift.Sift --server=false -- "$@"
